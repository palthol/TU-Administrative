# Base URL of the admin API service (defaults to http://localhost:3001 if unset)
VITE_API_BASE_URL=http://localhost:3001

# The active dashboard asks the operator for the admin API key at runtime. Do not put the
# key in a VITE_* variable because Vite variables are included in the browser bundle.

# Supabase project (publishable anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Optional: link to the receipts app from the dashboard header
VITE_RECEIPTS_APP_URL=http://localhost:5176
