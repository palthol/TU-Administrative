# Base URL of the admin API service (defaults to http://localhost:3001 if unset)
VITE_API_BASE_URL=http://localhost:3001

# Enter the staff/admin key at runtime. Never configure it in a VITE_* variable.

# Optional: link to the receipts app from the dashboard header
VITE_RECEIPTS_APP_URL=http://localhost:5176

# Optional: separate Cloudflare Access waiver viewer
VITE_WAIVER_VIEWER_APP_URL=http://localhost:5177
