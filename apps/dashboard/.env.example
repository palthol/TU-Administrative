# Optional. In dev, defaults to http://localhost:3001. In production builds,
# defaults to https://api.templeunderground.com.
# Set only to point the UI at a different API origin.
# VITE_API_BASE_URL=https://api.templeunderground.com

# Enter the staff/admin key at runtime. Never configure it in a VITE_* variable.

# Local tool links for `npm run dev` only. Production builds ignore loopback
# values and open the deployed tools instead:
#   receipts → https://finance.templeunderground.com
#   waiver review → https://waiverviewer.templeunderground.com
# Set a public https URL here only to point a build at a different host.
VITE_RECEIPTS_APP_URL=http://localhost:5176
VITE_WAIVER_VIEWER_APP_URL=http://localhost:5177
