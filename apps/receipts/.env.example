# Optional. In dev, defaults to http://localhost:3001. In production builds,
# defaults to https://api.templeunderground.com.
# Set only to point the UI at a different API origin.
# VITE_API_BASE_URL=https://api.templeunderground.com

# Admin API key. Visible in the browser bundle — use only for private/trusted deployments.
# Must match the API service's ADMIN_API_KEY.
VITE_ADMIN_API_KEY=your-admin-api-key

# Supabase project (publishable anon key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
