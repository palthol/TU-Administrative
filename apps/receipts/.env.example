# Optional. In dev, defaults to http://localhost:3001. In production builds,
# defaults to https://api.templeunderground.com.
# Set only to point the UI at a different API origin.
# VITE_API_BASE_URL=https://api.templeunderground.com

# Optional. Used for SSO redirects on 401s and after sign-out.
# In dev, defaults to the local dashboard sign-in page. In production builds,
# defaults to https://admin.templeunderground.com/login.
# VITE_LOGIN_URL=https://admin.templeunderground.com/login

# Staff/admin keys are entered at runtime only when the SSO endpoints are not deployed yet.
# Never configure credentials in a VITE_* variable.
