+import express from 'express';
+import request from 'supertest';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { requireAdmin } from '../../lib/requireAdmin.js';
+import { createRequireAdminOrCron } from '../../lib/requireAdminOrCron.js';
+import { registerAdminNotificationRoutes } from './notifications.js';
+
+const ADMIN_KEY = 'api-test-discord-admin-key';
+const WEBHOOK = 'https://discord.test/webhook';
+
+function createApp(supabase) {
+  const app = express();
+  app.use(express.json());
+  const router = express.Router();
+  router.use(createRequireAdminOrCron(requireAdmin));
+  registerAdminNotificationRoutes(router, { supabase });
+  app.use('/api/admin', router);
+  return app;
+}
+
+function reminderBuilder(rows) {
+  const builder = {
+    select: vi.fn(() => builder),
+    order: vi.fn(async () => ({ data: rows, error: null })),
+  };
+  return builder;
+}
+
+function leadBuilder(count) {
+  const builder = {
+    select: vi.fn(() => builder),
+    gte: vi.fn(async () => ({ count, error: null })),
+  };
+  return builder;
+}
+
+function createSupabase({ reminders, issueCharges, leadCount = 0 }) {
+  return {
+    from: vi.fn((table) => {
+      if (table === 'view_member_payment_reminders') return reminderBuilder(reminders);
+      if (table === 'marketing_leads') return leadBuilder(leadCount);
+      throw new Error(`unexpected table ${table}`);
+    }),
+    rpc: vi.fn(async (name) => {
+      if (name !== 'list_issue_charge_reminders') throw new Error(name);
+      return { data: issueCharges, error: null };
+    }),
+  };
+}
+
+describe('discord payment reminders', () => {
+  let previousAdminKey;
+  let previousWebhook;
+
+  beforeEach(() => {
+    previousAdminKey = process.env.ADMIN_API_KEY;
+    previousWebhook = process.env.DISCORD_WEBHOOK_URL;
+    process.env.ADMIN_API_KEY = ADMIN_KEY;
+    process.env.DISCORD_WEBHOOK_URL = WEBHOOK;
+    vi.stubGlobal('fetch', vi.fn(async () => ({
+      ok: true,
+      status: 204,
+      text: async () => '',
+      headers: { get: () => null },
+    })));
+  });
+
+  afterEach(() => {
+    if (previousAdminKey === undefined) delete process.env.ADMIN_API_KEY;
+    else process.env.ADMIN_API_KEY = previousAdminKey;
+    if (previousWebhook === undefined) delete process.env.DISCORD_WEBHOOK_URL;
+    else process.env.DISCORD_WEBHOOK_URL = previousWebhook;
+    vi.unstubAllGlobals();
+  });
+
+  it('keeps an expected-pay-only person out of the 3-day charge count and in issue_charge', async () => {
+    const supabase = createSupabase({
+      reminders: [],
+      issueCharges: [{
+        full_name: 'Natalie',
+        price_cents: 15000,
+        expected_pay_on: '2026-10-20',
+        plan_name: 'Core Group Plan',
+      }],
+    });
+    const res = await request(createApp(supabase))
+      .post('/api/admin/notifications/discord/payment-reminders')
+      .set('x-admin-key', ADMIN_KEY);
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({ ok: true, posted: true, rowCount: 0, issueChargeCount: 1 });
+    const posted = JSON.parse(fetch.mock.calls[0][1].body).content;
+    expect(posted).toContain('**Overdue (0)**');
+    expect(posted).toContain('**Due soon (0)**');
+    expect(posted).toContain('**Issue a charge (1)**');
+    expect(posted).toContain('Natalie — $150.00 expected 2026-10-20 (Core Group Plan)');
+    expect(supabase.rpc).toHaveBeenCalledWith('list_issue_charge_reminders');
+    expect(supabase.from).toHaveBeenCalledWith('view_member_payment_reminders');
+  });
+
+  it('adds the issue-a-charge section to the daily digest', async () => {
+    const supabase = createSupabase({
+      reminders: [{
+        name: 'William',
+        next_due_date: '2026-10-14',
+        days_late: 2,
+        reminder_bucket: 'overdue',
+        actual_price: 150,
+      }],
+      issueCharges: [{
+        full_name: 'Natalie',
+        price_cents: 15000,
+        expected_pay_on: '2026-10-18',
+        plan_name: 'Core Group Plan',
+      }],
+      leadCount: 1,
+    });
+    const res = await request(createApp(supabase))
+      .post('/api/admin/notifications/discord/daily-digest')
+      .set('x-admin-key', ADMIN_KEY);
+    expect(res.status).toBe(200);
+    expect(res.body.summary.reminderTotal).toBe(1);
+    expect(res.body.summary.issueChargeCount).toBe(1);
+    const posted = JSON.parse(fetch.mock.calls[0][1].body).content;
+    expect(posted).toContain('William — $150.00 due 2026-10-14');
+    expect(posted).toContain('**Issue a charge (1)**');
+    expect(posted).toContain('Natalie — $150.00 expected 2026-10-18 (Core Group Plan)');
+  });
+});
