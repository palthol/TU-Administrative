+create or replace function public.create_catalog_plan(
+  p_name text,
+  p_description text,
+  p_plan_category text,
+  p_billing_cadence text,
+  p_price_cents integer,
+  p_copy_access_from_plan_id uuid
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_name text;
+  v_plan_id uuid;
+  v_count integer;
+begin
+  v_name := nullif(btrim(coalesce(p_name, '')), '');
+  if v_name is null then
+    raise exception 'name_required';
+  end if;
+  if p_plan_category is null or p_plan_category not in ('group', 'private', 'hybrid') then
+    raise exception 'invalid_plan_category';
+  end if;
+  if p_billing_cadence is null or p_billing_cadence not in ('per_session', 'monthly', 'contract', 'custom') then
+    raise exception 'invalid_billing_cadence';
+  end if;
+  if p_price_cents is null or p_price_cents < 0 then
+    raise exception 'invalid_price_cents';
+  end if;
+  if p_copy_access_from_plan_id is null then
+    raise exception 'copy_access_from_plan_id_required';
+  end if;
+  if not exists (
+    select 1 from public.plan_definitions pd where pd.id = p_copy_access_from_plan_id
+  ) then
+    raise exception 'source_plan_not_found';
+  end if;
+
+  perform pg_advisory_xact_lock(hashtextextended('finance-roster-plan:' || lower(v_name), 0));
+
+  if exists (
+    select 1
+    from public.plan_definitions pd
+    where pd.is_active
+      and lower(btrim(pd.name)) = lower(v_name)
+  ) then
+    raise exception 'plan_name_taken';
+  end if;
+
+  insert into public.plan_definitions (
+    name,
+    description,
+    plan_category,
+    billing_cadence,
+    price_cents,
+    currency,
+    is_active
+  )
+  values (
+    v_name,
+    nullif(btrim(coalesce(p_description, '')), ''),
+    p_plan_category,
+    p_billing_cadence,
+    p_price_cents,
+    'USD',
+    true
+  )
+  returning id into v_plan_id;
+
+  insert into public.plan_entitlements (
+    plan_definition_id,
+    scope,
+    unit,
+    limit_type,
+    quantity,
+    reset_rule,
+    week_starts_on,
+    applies_to
+  )
+  select
+    v_plan_id,
+    pe.scope,
+    pe.unit,
+    pe.limit_type,
+    pe.quantity,
+    pe.reset_rule,
+    pe.week_starts_on,
+    pe.applies_to
+  from public.plan_entitlements pe
+  where pe.plan_definition_id = p_copy_access_from_plan_id;
+
+  get diagnostics v_count = row_count;
+
+  return jsonb_build_object(
+    'plan', jsonb_build_object(
+      'plan_definition_id', v_plan_id,
+      'name', v_name,
+      'plan_category', p_plan_category,
+      'billing_cadence', p_billing_cadence,
+      'price_cents', p_price_cents,
+      'currency', 'USD',
+      'is_active', true,
+      'access_copied_from_plan_id', p_copy_access_from_plan_id,
+      'entitlement_count', v_count
+    )
+  );
+end;
+$$;
+
+comment on function public.create_catalog_plan(text, text, text, text, integer, uuid) is
+  'Inserts one active USD plan and copies plan_entitlements from the source plan. Does not enroll a participant or insert a charge.';
+
+revoke all on function public.create_catalog_plan(text, text, text, text, integer, uuid) from public;
+revoke all on function public.create_catalog_plan(text, text, text, text, integer, uuid) from anon;
+revoke all on function public.create_catalog_plan(text, text, text, text, integer, uuid) from authenticated;
+grant execute on function public.create_catalog_plan(text, text, text, text, integer, uuid) to service_role;
