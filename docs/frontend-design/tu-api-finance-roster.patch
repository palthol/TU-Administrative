+create or replace function public.list_issue_charge_reminders(p_as_of date default current_date)
+returns table (
+  participant_id uuid,
+  account_id uuid,
+  subscription_id uuid,
+  full_name text,
+  plan_name text,
+  price_cents integer,
+  expected_pay_on date
+)
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select
+    s.participant_id,
+    s.account_id,
+    s.id,
+    p.full_name,
+    pd.name,
+    pd.price_cents,
+    s.expected_pay_on
+  from public.subscriptions s
+  join public.participants p on p.id = s.participant_id
+  join public.plan_definitions pd on pd.id = s.plan_definition_id
+  where s.status = 'active'
+    and s.expected_pay_on is not null
+    and s.expected_pay_on <= (p_as_of + 7)
+    and not exists (
+      select 1
+      from public.charges c
+      where c.subscription_id = s.id
+        and c.status = 'open'
+        and c.due_at = s.expected_pay_on
+    )
+  order by s.expected_pay_on, p.full_name, s.id;
+$$;
+
+comment on function public.list_issue_charge_reminders(date) is
+  'Active subscriptions whose expected_pay_on is on or before today+7 and that have no open charge due that day.';
+
+revoke all on function public.list_issue_charge_reminders(date) from public;
+revoke all on function public.list_issue_charge_reminders(date) from anon;
+revoke all on function public.list_issue_charge_reminders(date) from authenticated;
+grant execute on function public.list_issue_charge_reminders(date) to service_role;
+
+create or replace function public.list_account_roster(
+  p_limit integer,
+  p_offset integer,
+  p_status text,
+  p_query text
+)
+returns jsonb
+language plpgsql
+stable
+security definer
+set search_path = public
+as $$
+declare
+  v_rows jsonb;
+  v_like text;
+begin
+  if p_status is null or p_status not in ('active', 'inactive', 'all') then
+    raise exception 'invalid_status';
+  end if;
+  if p_limit is null or p_limit < 1 or p_limit > 200 then
+    raise exception 'invalid_limit';
+  end if;
+  if p_offset is null or p_offset < 0 then
+    raise exception 'invalid_offset';
+  end if;
+
+  if p_query is null or btrim(p_query) = '' then
+    v_like := null;
+  else
+    v_like := '%' || replace(replace(replace(btrim(p_query), '\', '\\'), '%', '\%'), '_', '\_') || '%';
+  end if;
+
+  select coalesce(
+    jsonb_agg(page.account_json order by page.primary_contact_name nulls last, page.account_id),
+    '[]'::jsonb
+  )
+  into v_rows
+  from (
+    select
+      a.id as account_id,
+      a.primary_contact_name,
+      jsonb_build_object(
+        'account_id', a.id,
+        'status', a.status,
+        'primary_contact_name', a.primary_contact_name,
+        'members', coalesce((
+          select jsonb_agg(members.member_json order by members.member_name, members.participant_id)
+          from (
+            select
+              p.full_name as member_name,
+              am.participant_id,
+              jsonb_build_object(
+                'participant_id', am.participant_id,
+                'full_name', p.full_name,
+                'role', am.role,
+                'subscription', (
+                  select jsonb_build_object(
+                    'subscription_id', s.id,
+                    'status', s.status,
+                    'plan_definition_id', s.plan_definition_id,
+                    'plan_name', pd.name,
+                    'billing_cadence', pd.billing_cadence,
+                    'price_cents', pd.price_cents,
+                    'starts_at', to_char(s.starts_at, 'YYYY-MM-DD'),
+                    'ends_at', case when s.ends_at is null then null else to_char(s.ends_at, 'YYYY-MM-DD') end,
+                    'expected_pay_on', case when s.expected_pay_on is null then null else to_char(s.expected_pay_on, 'YYYY-MM-DD') end,
+                    'automatic_billing_starts_at', case when s.automatic_billing_starts_at is null then null else to_char(s.automatic_billing_starts_at, 'YYYY-MM-DD') end,
+                    'open_charge', (
+                      select jsonb_build_object(
+                        'charge_id', c.id,
+                        'amount_cents', c.amount_cents,
+                        'due_at', to_char(c.due_at, 'YYYY-MM-DD'),
+                        'status', c.status
+                      )
+                      from public.charges c
+                      where c.subscription_id = s.id
+                        and c.status = 'open'
+                      order by
+                        case
+                          when s.expected_pay_on is not null and c.due_at = s.expected_pay_on then 0
+                          else 1
+                        end,
+                        c.due_at,
+                        c.created_at
+                      limit 1
+                    )
+                  )
+                  from public.subscriptions s
+                  join public.plan_definitions pd on pd.id = s.plan_definition_id
+                  where s.account_id = a.id
+                    and s.participant_id = am.participant_id
+                    and s.status = 'active'
+                  order by s.starts_at desc, s.created_at desc
+                  limit 1
+                ),
+                'other_accounts', coalesce((
+                  select jsonb_agg(
+                    jsonb_build_object(
+                      'account_id', oa.id,
+                      'primary_contact_name', oa.primary_contact_name,
+                      'status', oa.status,
+                      'financially_empty', public.account_is_financially_empty(oa.id)
+                    )
+                    order by oa.primary_contact_name nulls last, oa.id
+                  )
+                  from public.account_members om
+                  join public.accounts oa on oa.id = om.account_id
+                  where om.participant_id = am.participant_id
+                    and om.account_id <> a.id
+                ), '[]'::jsonb)
+              ) as member_json
+            from public.account_members am
+            join public.participants p on p.id = am.participant_id
+            where am.account_id = a.id
+          ) members
+        ), '[]'::jsonb)
+      ) as account_json
+    from public.accounts a
+    where (p_status = 'all' or a.status = p_status)
+      and (
+        v_like is null
+        or a.primary_contact_name ilike v_like escape '\'
+        or exists (
+          select 1
+          from public.account_members amq
+          join public.participants pq on pq.id = amq.participant_id
+          where amq.account_id = a.id
+            and pq.full_name ilike v_like escape '\'
+        )
+      )
+    order by a.primary_contact_name asc nulls last, a.id
+    limit p_limit
+    offset p_offset
+  ) page;
+
+  return jsonb_build_object('rows', coalesce(v_rows, '[]'::jsonb));
+end;
+$$;
+
+comment on function public.list_account_roster(integer, integer, text, text) is
+  'Account page for the finance roster: members, the active subscription, expected_pay_on, open charge, and other accounts with financially_empty.';
+
+revoke all on function public.list_account_roster(integer, integer, text, text) from public;
+revoke all on function public.list_account_roster(integer, integer, text, text) from anon;
+revoke all on function public.list_account_roster(integer, integer, text, text) from authenticated;
+grant execute on function public.list_account_roster(integer, integer, text, text) to service_role;
