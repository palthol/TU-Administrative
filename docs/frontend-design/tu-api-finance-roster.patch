@@ -0,0 +1,318 @@
+/**
+ * Finance roster reads and writes. Mounted behind requireAdmin.
+ * front_desk is rejected by the staff role matrix before these handlers run.
+ */
+
+import { isIsoDate } from '../../lib/isoDate.js';
+
+const PLAN_CATEGORIES = new Set(['group', 'private', 'hybrid']);
+const BILLING_CADENCES = new Set(['per_session', 'monthly', 'contract', 'custom']);
+const MEMBER_ROLES = new Set(['member', 'payer', 'guardian']);
+
+function rpcMessage(error) {
+  const message = String(error?.message || '').trim();
+  return message || 'request_failed';
+}
+
+function asObject(data) {
+  if (data && typeof data === 'object' && !Array.isArray(data)) return data;
+  if (typeof data === 'string') {
+    try {
+      const parsed = JSON.parse(data);
+      if (parsed && typeof parsed === 'object') return parsed;
+    } catch {
+      return {};
+    }
+  }
+  return {};
+}
+
+function parseLimit(raw) {
+  if (raw == null || raw === '') return 50;
+  const parsed = Number.parseInt(String(raw), 10);
+  if (!Number.isFinite(parsed)) return null;
+  return parsed;
+}
+
+function parseOffset(raw) {
+  if (raw == null || raw === '') return 0;
+  const parsed = Number.parseInt(String(raw), 10);
+  if (!Number.isFinite(parsed)) return null;
+  return parsed;
+}
+
+/**
+ * @param {import('express').Router} router
+ * @param {{ supabase: import('@supabase/supabase-js').SupabaseClient | null }} ctx
+ */
+export function registerFinanceRosterRoutes(router, { supabase }) {
+  router.get('/billing/account-roster', async (req, res) => {
+    try {
+      if (!supabase) return res.status(500).json({ ok: false, error: 'supabase_not_configured' });
+      const limit = parseLimit(req.query.limit);
+      const offset = parseOffset(req.query.offset);
+      if (limit == null || limit < 1 || limit > 200) {
+        return res.status(400).json({ ok: false, error: 'invalid_limit' });
+      }
+      if (offset == null || offset < 0) {
+        return res.status(400).json({ ok: false, error: 'invalid_offset' });
+      }
+      const status = typeof req.query.status === 'string' && req.query.status.length
+        ? req.query.status
+        : 'active';
+      if (!['active', 'inactive', 'all'].includes(status)) {
+        return res.status(400).json({ ok: false, error: 'invalid_status' });
+      }
+      const q = typeof req.query.q === 'string' ? req.query.q.trim() : '';
+      if (q && q.length < 2) {
+        return res.status(400).json({ ok: false, error: 'query_min_length_2' });
+      }
+
+      const { data, error } = await supabase.rpc('list_account_roster', {
+        p_limit: limit,
+        p_offset: offset,
+        p_status: status,
+        p_query: q || null,
+      });
+      if (error) return res.status(400).json({ ok: false, error: rpcMessage(error) });
+      const rows = Array.isArray(asObject(data).rows) ? asObject(data).rows : [];
+      return res.json({ ok: true, limit, offset, rowCount: rows.length, rows });
+    } catch (e) {
+      console.error(e);
+      return res.status(500).json({ ok: false, error: 'server_error' });
+    }
+  });
+
+  router.get('/billing/plans', async (req, res) => {
+    try {
+      if (!supabase) return res.status(500).json({ ok: false, error: 'supabase_not_configured' });
+      const active = typeof req.query.active === 'string' ? req.query.active : 'true';
+      if (!['true', 'false', 'all'].includes(active)) {
+        return res.status(400).json({ ok: false, error: 'invalid_active' });
+      }
+      let query = supabase
+        .from('plan_definitions')
+        .select('id, name, plan_category, billing_cadence, price_cents, currency, is_active');
+      if (active === 'true') query = query.eq('is_active', true);
+      if (active === 'false') query = query.eq('is_active', false);
+      const { data, error } = await query.order('name', { ascending: true });
+      if (error) return res.status(400).json({ ok: false, error: error.message });
+      const rows = (data || []).map((row) => ({
+        plan_definition_id: row.id,
+        name: row.name,
+        plan_category: row.plan_category,
+        billing_cadence: row.billing_cadence,
+        price_cents: row.price_cents,
+        currency: row.currency || 'USD',
+        is_active: row.is_active,
+      }));
+      return res.json({ ok: true, rows });
+    } catch (e) {
+      console.error(e);
+      return res.status(500).json({ ok: false, error: 'server_error' });
+    }
+  });
+
+  router.post('/billing/plans', async (req, res) => {
+    try {
+      if (!supabase) return res.status(500).json({ ok: false, error: 'supabase_not_configured' });
+      const {
+        name,
+        description,
+        plan_category,
+        billing_cadence,
+        price_cents,
+        copy_access_from_plan_id,
+      } = req.body || {};
+      if (typeof name !== 'string' || !name.trim()) {
+        return res.status(400).json({ ok: false, error: 'name_required' });
+      }
+      if (description != null && typeof description !== 'string') {
+        return res.status(400).json({ ok: false, error: 'invalid_description' });
+      }
+      if (!PLAN_CATEGORIES.has(plan_category)) {
+        return res.status(400).json({ ok: false, error: 'invalid_plan_category' });
+      }
+      if (!BILLING_CADENCES.has(billing_cadence)) {
+        return res.status(400).json({ ok: false, error: 'invalid_billing_cadence' });
+      }
+      if (typeof price_cents !== 'number' || !Number.isInteger(price_cents) || price_cents < 0) {
+        return res.status(400).json({ ok: false, error: 'invalid_price_cents' });
+      }
+      if (typeof copy_access_from_plan_id !== 'string' || !copy_access_from_plan_id.trim()) {
+        return res.status(400).json({ ok: false, error: 'copy_access_from_plan_id_required' });
+      }
+
+      const { data, error } = await supabase.rpc('create_catalog_plan', {
+        p_name: name.trim(),
+        p_description: description ?? null,
+        p_plan_category: plan_category,
+        p_billing_cadence: billing_cadence,
+        p_price_cents: price_cents,
+        p_copy_access_from_plan_id: copy_access_from_plan_id.trim(),
+      });
+      if (error) return res.status(400).json({ ok: false, error: rpcMessage(error) });
+      const plan = asObject(data).plan;
+      if (!plan) return res.status(500).json({ ok: false, error: 'server_error' });
+      return res.json({ ok: true, plan });
+    } catch (e) {
+      console.error(e);
+      return res.status(500).json({ ok: false, error: 'server_error' });
+    }
+  });
+
+  router.patch('/billing/subscriptions/:subscriptionId', async (req, res) => {
+    try {
+      if (!supabase) return res.status(500).json({ ok: false, error: 'supabase_not_configured' });
+      const subscriptionId = typeof req.params.subscriptionId === 'string'
+        ? req.params.subscriptionId.trim()
+        : '';
+      if (!subscriptionId) {
+        return res.status(400).json({ ok: false, error: 'subscription_not_found' });
+      }
+      const expectedPayOn = req.body?.expected_pay_on;
+      if (!isIsoDate(expectedPayOn)) {
+        return res.status(400).json({ ok: false, error: 'invalid_expected_pay_on' });
+      }
+      const keys = req.body && typeof req.body === 'object' ? Object.keys(req.body) : [];
+      if (keys.some((key) => key !== 'expected_pay_on')) {
+        return res.status(400).json({ ok: false, error: 'invalid_expected_pay_on' });
+      }
+
+      const { data, error } = await supabase.rpc('set_subscription_expected_pay_on', {
+        p_subscription_id: subscriptionId,
+        p_expected_pay_on: expectedPayOn,
+      });
+      if (error) return res.status(400).json({ ok: false, error: rpcMessage(error) });
+      const result = asObject(data);
+      return res.json({
+        ok: true,
+        subscription_id: result.subscription_id ?? subscriptionId,
+        expected_pay_on: result.expected_pay_on ?? expectedPayOn,
+      });
+    } catch (e) {
+      console.error(e);
+      return res.status(500).json({ ok: false, error: 'server_error' });
+    }
+  });
+
+  router.post('/billing/charges', async (req, res) => {
+    try {
+      if (!supabase) return res.status(500).json({ ok: false, error: 'supabase_not_configured' });
+      const {
+        account_id,
+        subscription_id,
+        amount_cents,
+        due_at,
+        coverage_start,
+        coverage_end,
+        next_expected_pay_on,
+      } = req.body || {};
+      if (typeof subscription_id !== 'string' || !subscription_id.trim()) {
+        return res.status(400).json({ ok: false, error: 'subscription_not_found' });
+      }
+      if (typeof account_id !== 'string' || !account_id.trim()) {
+        return res.status(400).json({ ok: false, error: 'charge_account_mismatch' });
+      }
+      if (typeof amount_cents !== 'number' || !Number.isInteger(amount_cents) || amount_cents <= 0) {
+        return res.status(400).json({ ok: false, error: 'invalid_amount_cents' });
+      }
+      if (!isIsoDate(due_at)) {
+        return res.status(400).json({ ok: false, error: 'invalid_due_at' });
+      }
+      if (!isIsoDate(next_expected_pay_on)) {
+        return res.status(400).json({ ok: false, error: 'invalid_expected_pay_on' });
+      }
+      if (coverage_start != null && !isIsoDate(coverage_start)) {
+        return res.status(400).json({ ok: false, error: 'invalid_due_at' });
+      }
+      if (coverage_end != null && !isIsoDate(coverage_end)) {
+        return res.status(400).json({ ok: false, error: 'coverage_end_before_start' });
+      }
+      const resolvedStart = coverage_start || due_at;
+      const resolvedEnd = coverage_end || shiftIsoDate(next_expected_pay_on, -1);
+      if (resolvedEnd < resolvedStart) {
+        return res.status(400).json({ ok: false, error: 'coverage_end_before_start' });
+      }
+
+      const { data, error } = await supabase.rpc('issue_manual_subscription_charge', {
+        p_account_id: account_id.trim(),
+        p_subscription_id: subscription_id.trim(),
+        p_amount_cents: amount_cents,
+        p_due_at: due_at,
+        p_next_expected_pay_on: next_expected_pay_on,
+        p_coverage_start: coverage_start || null,
+        p_coverage_end: coverage_end || null,
+      });
+      if (error) return res.status(400).json({ ok: false, error: rpcMessage(error) });
+      const result = asObject(data);
+      return res.json({
+        ok: true,
+        charge_id: result.charge_id ?? null,
+        account_id: result.account_id ?? account_id,
+        subscription_id: result.subscription_id ?? subscription_id,
+        amount_cents: result.amount_cents ?? amount_cents,
+        due_at: result.due_at ?? due_at,
+        expected_pay_on: result.expected_pay_on ?? next_expected_pay_on,
+      });
+    } catch (e) {
+      console.error(e);
+      return res.status(500).json({ ok: false, error: 'server_error' });
+    }
+  });
+
+  router.post('/billing/household-moves', async (req, res) => {
+    try {
+      if (!supabase) return res.status(500).json({ ok: false, error: 'supabase_not_configured' });
+      const {
+        participant_id,
+        destination_account_id,
+        role,
+        deactivate_source_account_id,
+      } = req.body || {};
+      if (typeof participant_id !== 'string' || !participant_id.trim()) {
+        return res.status(400).json({ ok: false, error: 'participant_id_required' });
+      }
+      if (typeof destination_account_id !== 'string' || !destination_account_id.trim()) {
+        return res.status(400).json({ ok: false, error: 'destination_account_id_required' });
+      }
+      if (!MEMBER_ROLES.has(role)) {
+        return res.status(400).json({ ok: false, error: 'invalid_role' });
+      }
+      if (
+        deactivate_source_account_id != null
+        && (typeof deactivate_source_account_id !== 'string' || !deactivate_source_account_id.trim())
+      ) {
+        return res.status(400).json({ ok: false, error: 'source_account_required_member' });
+      }
+
+      const { data, error } = await supabase.rpc('move_household_member', {
+        p_participant_id: participant_id.trim(),
+        p_destination_account_id: destination_account_id.trim(),
+        p_role: role,
+        p_deactivate_source_account_id: typeof deactivate_source_account_id === 'string'
+          ? deactivate_source_account_id.trim()
+          : null,
+      });
+      if (error) return res.status(400).json({ ok: false, error: rpcMessage(error) });
+      const result = asObject(data);
+      return res.json({
+        ok: true,
+        participant_id: result.participant_id ?? participant_id,
+        destination_account_id: result.destination_account_id ?? destination_account_id,
+        role: result.role ?? role,
+        membership: result.membership,
+        deactivated_account_id: result.deactivated_account_id ?? null,
+      });
+    } catch (e) {
+      console.error(e);
+      return res.status(500).json({ ok: false, error: 'server_error' });
+    }
+  });
+}
+
+function shiftIsoDate(iso, days) {
+  const [year, month, day] = iso.split('-').map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day + days));
+  return date.toISOString().slice(0, 10);
+}
