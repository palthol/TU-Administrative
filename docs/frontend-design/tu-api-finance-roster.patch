diff --git a/supabase/migrations/20261016120000_finance_roster_expected_pay_on.sql b/supabase/migrations/20261016120000_finance_roster_expected_pay_on.sql
new file mode 100644
index 0000000..b3e9cf9
--- /dev/null
+++ b/supabase/migrations/20261016120000_finance_roster_expected_pay_on.sql
@@ -0,0 +1,834 @@
+-- Finance roster: expected_pay_on is a reminder date only.
+-- Null means no reminder. This migration does not backfill production rows,
+-- does not set automatic_billing_starts_at, and does not rewrite charges.due_at.
+
+alter table public.subscriptions
+  add column if not exists expected_pay_on date;
+
+comment on column public.subscriptions.expected_pay_on is
+  'Date the operator wants a reminder to issue a charge by hand. Null means no reminder. Not automatic_billing_starts_at. Changing it must not rewrite charges.due_at.';
+
+create index if not exists idx_subscriptions_expected_pay_on
+  on public.subscriptions (expected_pay_on)
+  where status = 'active' and expected_pay_on is not null;
+
+-- Replace create_subscription. Extra arguments are defaulted so the previous
+-- 8-argument call keeps today's paid-monthly automation behavior.
+drop function if exists public.create_subscription(uuid, uuid, date, date, uuid, boolean, text, text);
+drop function if exists public.create_subscription(uuid, uuid, date, date, uuid, boolean, text, text, boolean, date, boolean);
+
+create or replace function public.create_subscription(
+  p_participant_id uuid,
+  p_plan_definition_id uuid,
+  p_starts_at date default current_date,
+  p_ends_at date default null,
+  p_account_id uuid default null,
+  p_create_initial_charge boolean default false,
+  p_notes text default null,
+  p_created_by text default null,
+  p_arm_automatic_billing boolean default null,
+  p_expected_pay_on date default null,
+  p_require_explicit_account boolean default false
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_participant record;
+  v_plan record;
+  v_account_id uuid;
+  v_subscription_id uuid;
+  v_initial_charge_id uuid;
+  v_coverage_start date;
+  v_initial_coverage_start date;
+  v_coverage_end date;
+  v_automatic_billing_starts_at date;
+  v_coverage_ready boolean := false;
+begin
+  if p_participant_id is null then
+    raise exception 'participant id is required';
+  end if;
+  if p_plan_definition_id is null then
+    raise exception 'plan definition id is required';
+  end if;
+  if coalesce(p_require_explicit_account, false) and p_account_id is null then
+    raise exception 'account_id_required';
+  end if;
+
+  v_coverage_start := coalesce(p_starts_at, current_date);
+  if p_ends_at is not null and p_ends_at < v_coverage_start then
+    raise exception 'ends_at must be on or after starts_at';
+  end if;
+
+  select p.id into v_participant
+  from public.participants p
+  where p.id = p_participant_id
+  for update;
+  if v_participant.id is null then
+    raise exception 'Participant not found: %', p_participant_id;
+  end if;
+
+  select
+    pd.id,
+    pd.price_cents,
+    pd.currency,
+    pd.billing_cadence,
+    pd.is_active,
+    pd.name
+  into v_plan
+  from public.plan_definitions pd
+  where pd.id = p_plan_definition_id;
+  if v_plan.id is null then
+    raise exception 'Plan not found: %', p_plan_definition_id;
+  end if;
+  if not v_plan.is_active then
+    raise exception 'Plan is not active: %', p_plan_definition_id;
+  end if;
+
+  if v_plan.billing_cadence = 'monthly' and v_plan.price_cents > 0 then
+    v_initial_coverage_start := greatest(v_coverage_start, current_date);
+    if p_ends_at is null or p_ends_at >= v_initial_coverage_start then
+      v_coverage_end := (
+        date_trunc('month', v_initial_coverage_start::timestamp)
+        + interval '1 month'
+        - interval '1 day'
+      )::date;
+      if p_ends_at is not null and p_ends_at < v_coverage_end then
+        v_coverage_end := p_ends_at;
+      end if;
+      v_coverage_ready := true;
+      -- Omitted or true keeps today's generator anchor. Explicit false leaves it null.
+      if p_arm_automatic_billing is distinct from false then
+        v_automatic_billing_starts_at := v_coverage_end + 1;
+      end if;
+    end if;
+  end if;
+
+  v_account_id := p_account_id;
+  if v_account_id is null then
+    select am.account_id into v_account_id
+    from public.account_members am
+    where am.participant_id = p_participant_id
+    order by am.created_at asc
+    limit 1;
+  end if;
+  if v_account_id is null then
+    raise exception 'No account for participant %; provide account_id or bind account first', p_participant_id;
+  end if;
+  if not exists (
+    select 1 from public.accounts a where a.id = v_account_id and a.status = 'active'
+  ) then
+    raise exception 'Account not found or not active: %', v_account_id;
+  end if;
+  if not exists (
+    select 1
+    from public.account_members am
+    where am.account_id = v_account_id
+      and am.participant_id = p_participant_id
+  ) then
+    raise exception 'Participant % is not a member of account %', p_participant_id, v_account_id;
+  end if;
+
+  if exists (
+    select 1
+    from public.subscriptions s
+    where s.participant_id = p_participant_id
+      and s.status = 'active'
+      and (p_ends_at is null or s.starts_at <= p_ends_at)
+      and (s.ends_at is null or s.ends_at >= v_coverage_start)
+  ) then
+    raise exception 'overlapping_active_subscription';
+  end if;
+
+  insert into public.subscriptions (
+    account_id,
+    participant_id,
+    plan_definition_id,
+    status,
+    starts_at,
+    ends_at,
+    automatic_billing_starts_at,
+    expected_pay_on,
+    notes
+  )
+  values (
+    v_account_id,
+    p_participant_id,
+    p_plan_definition_id,
+    'active',
+    v_coverage_start,
+    p_ends_at,
+    v_automatic_billing_starts_at,
+    p_expected_pay_on,
+    nullif(btrim(coalesce(p_notes, '')), '')
+  )
+  returning id into v_subscription_id;
+
+  if coalesce(p_create_initial_charge, false)
+    and v_plan.billing_cadence = 'monthly'
+    and v_plan.price_cents > 0
+    and v_coverage_ready
+  then
+    insert into public.charges (
+      account_id,
+      subscription_id,
+      amount_cents,
+      currency,
+      coverage_start,
+      coverage_end,
+      due_at,
+      status,
+      charge_kind,
+      notes
+    )
+    values (
+      v_account_id,
+      v_subscription_id,
+      v_plan.price_cents,
+      coalesce(v_plan.currency, 'USD'),
+      v_initial_coverage_start,
+      v_coverage_end,
+      v_initial_coverage_start,
+      'open',
+      'monthly_period',
+      concat_ws(
+        ' | ',
+        format('Initial monthly charge for plan %s', v_plan.name),
+        case
+          when p_created_by is not null and btrim(p_created_by) <> ''
+            then 'created_by=' || btrim(p_created_by)
+          else null
+        end
+      )
+    )
+    on conflict (subscription_id, coverage_start)
+      where subscription_id is not null
+        and status <> 'void'
+        and charge_kind = 'monthly_period'
+      do nothing
+    returning id into v_initial_charge_id;
+  elsif coalesce(p_create_initial_charge, false)
+    and v_plan.billing_cadence <> 'monthly'
+  then
+    raise exception
+      'create_initial_charge only applies to monthly plans (plan % has cadence %)',
+      p_plan_definition_id,
+      v_plan.billing_cadence;
+  end if;
+
+  return jsonb_build_object(
+    'subscription_id', v_subscription_id,
+    'account_id', v_account_id,
+    'participant_id', p_participant_id,
+    'plan_definition_id', p_plan_definition_id,
+    'initial_charge_id', v_initial_charge_id,
+    'automatic_billing_starts_at', v_automatic_billing_starts_at
+  );
+end;
+$$;
+
+comment on function public.create_subscription(uuid, uuid, date, date, uuid, boolean, text, text, boolean, date, boolean) is
+  'Creates an active subscription. arm_automatic_billing false leaves automatic_billing_starts_at null. Omitted keeps the paid-monthly generator anchor. Rejects an overlapping active subscription for the participant.';
+
+revoke all on function public.create_subscription(uuid, uuid, date, date, uuid, boolean, text, text, boolean, date, boolean) from public;
+revoke all on function public.create_subscription(uuid, uuid, date, date, uuid, boolean, text, text, boolean, date, boolean) from anon;
+revoke all on function public.create_subscription(uuid, uuid, date, date, uuid, boolean, text, text, boolean, date, boolean) from authenticated;
+grant execute on function public.create_subscription(uuid, uuid, date, date, uuid, boolean, text, text, boolean, date, boolean) to service_role;
+
+create or replace function public.set_subscription_expected_pay_on(
+  p_subscription_id uuid,
+  p_expected_pay_on date
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_id uuid;
+begin
+  if p_subscription_id is null or p_expected_pay_on is null then
+    if p_subscription_id is null then
+      raise exception 'subscription_not_found';
+    end if;
+    raise exception 'invalid_expected_pay_on';
+  end if;
+
+  update public.subscriptions
+  set expected_pay_on = p_expected_pay_on
+  where id = p_subscription_id
+  returning id into v_id;
+
+  if v_id is null then
+    raise exception 'subscription_not_found';
+  end if;
+
+  return jsonb_build_object(
+    'subscription_id', v_id,
+    'expected_pay_on', to_char(p_expected_pay_on, 'YYYY-MM-DD')
+  );
+end;
+$$;
+
+comment on function public.set_subscription_expected_pay_on(uuid, date) is
+  'Writes subscriptions.expected_pay_on only. Does not change charges.due_at or automatic_billing_starts_at.';
+
+revoke all on function public.set_subscription_expected_pay_on(uuid, date) from public;
+revoke all on function public.set_subscription_expected_pay_on(uuid, date) from anon;
+revoke all on function public.set_subscription_expected_pay_on(uuid, date) from authenticated;
+grant execute on function public.set_subscription_expected_pay_on(uuid, date) to service_role;
+
+create or replace function public.issue_manual_subscription_charge(
+  p_account_id uuid,
+  p_subscription_id uuid,
+  p_amount_cents integer,
+  p_due_at date,
+  p_next_expected_pay_on date,
+  p_coverage_start date default null,
+  p_coverage_end date default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_account_id uuid;
+  v_charge_id uuid;
+  v_coverage_start date;
+  v_coverage_end date;
+begin
+  if p_subscription_id is null then
+    raise exception 'subscription_not_found';
+  end if;
+  if p_amount_cents is null or p_amount_cents <= 0 then
+    raise exception 'invalid_amount_cents';
+  end if;
+  if p_due_at is null then
+    raise exception 'invalid_due_at';
+  end if;
+  if p_next_expected_pay_on is null then
+    raise exception 'invalid_expected_pay_on';
+  end if;
+
+  select s.account_id into v_account_id
+  from public.subscriptions s
+  where s.id = p_subscription_id
+  for update;
+  if v_account_id is null then
+    raise exception 'subscription_not_found';
+  end if;
+  if p_account_id is null or v_account_id is distinct from p_account_id then
+    raise exception 'charge_account_mismatch';
+  end if;
+
+  v_coverage_start := coalesce(p_coverage_start, p_due_at);
+  v_coverage_end := coalesce(p_coverage_end, (p_next_expected_pay_on - 1));
+  if v_coverage_end < v_coverage_start then
+    raise exception 'coverage_end_before_start';
+  end if;
+
+  insert into public.charges (
+    account_id,
+    subscription_id,
+    amount_cents,
+    currency,
+    coverage_start,
+    coverage_end,
+    due_at,
+    status,
+    charge_kind
+  )
+  values (
+    p_account_id,
+    p_subscription_id,
+    p_amount_cents,
+    'USD',
+    v_coverage_start,
+    v_coverage_end,
+    p_due_at,
+    'open',
+    'manual'
+  )
+  returning id into v_charge_id;
+
+  if v_charge_id is null then
+    raise exception 'charge_insert_failed';
+  end if;
+
+  update public.subscriptions
+  set expected_pay_on = p_next_expected_pay_on
+  where id = p_subscription_id;
+
+  return jsonb_build_object(
+    'charge_id', v_charge_id,
+    'account_id', p_account_id,
+    'subscription_id', p_subscription_id,
+    'amount_cents', p_amount_cents,
+    'due_at', to_char(p_due_at, 'YYYY-MM-DD'),
+    'expected_pay_on', to_char(p_next_expected_pay_on, 'YYYY-MM-DD')
+  );
+end;
+$$;
+
+comment on function public.issue_manual_subscription_charge(uuid, uuid, integer, date, date, date, date) is
+  'Inserts one manual charge for the confirmed amount and, in the same transaction, stores next_expected_pay_on. Does not set automatic_billing_starts_at.';
+
+revoke all on function public.issue_manual_subscription_charge(uuid, uuid, integer, date, date, date, date) from public;
+revoke all on function public.issue_manual_subscription_charge(uuid, uuid, integer, date, date, date, date) from anon;
+revoke all on function public.issue_manual_subscription_charge(uuid, uuid, integer, date, date, date, date) from authenticated;
+grant execute on function public.issue_manual_subscription_charge(uuid, uuid, integer, date, date, date, date) to service_role;
+
+create or replace function public.account_is_financially_empty(p_account_id uuid)
+returns boolean
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select
+    not exists (select 1 from public.subscriptions s where s.account_id = p_account_id)
+    and not exists (select 1 from public.charges c where c.account_id = p_account_id)
+    and not exists (select 1 from public.payments p where p.account_id = p_account_id)
+    and not exists (select 1 from public.receipts r where r.account_id = p_account_id)
+    and not exists (select 1 from public.personal_finance_entries e where e.account_id = p_account_id);
+$$;
+
+comment on function public.account_is_financially_empty(uuid) is
+  'True when the account has zero subscriptions, charges, payments, receipts, and personal_finance_entries.';
+
+revoke all on function public.account_is_financially_empty(uuid) from public;
+revoke all on function public.account_is_financially_empty(uuid) from anon;
+revoke all on function public.account_is_financially_empty(uuid) from authenticated;
+grant execute on function public.account_is_financially_empty(uuid) to service_role;
