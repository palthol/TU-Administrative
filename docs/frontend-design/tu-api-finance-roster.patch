+create or replace function public._roster_test_fail_charge()
+returns trigger
+language plpgsql
+as $$
+begin
+  raise exception 'forced_charge_insert_failure';
+end;
+$$;
+
+create trigger _roster_test_fail_charge
+before insert on public.charges
+for each row execute function public._roster_test_fail_charge();
+
+select throws_ok(
+  $$select public.issue_manual_subscription_charge(
+    'f2000000-0000-4000-8000-000000000007',
+    (select (result->>'subscription_id')::uuid from roster_calls where label = 'issue_fail'),
+    15000,
+    date '2026-10-21',
+    date '2026-11-21',
+    null,
+    null
+  )$$,
+  'forced_charge_insert_failure',
+  'issue charge fails when the charge insert fails'
+);
+select is(
+  (
+    select s.expected_pay_on
+    from public.subscriptions s
+    join roster_calls r on s.id = (r.result->>'subscription_id')::uuid
+    where r.label = 'issue_fail'
+  ),
+  date '2026-10-21',
+  'expected_pay_on advances only if the charge insert succeeds'
+);
+select is(
+  (
+    select count(*)
+    from public.charges c
+    join roster_calls r on c.subscription_id = (r.result->>'subscription_id')::uuid
+    where r.label = 'issue_fail'
+  ),
+  0::bigint,
+  'a failed issue charge leaves no charge row'
+);
+
+drop trigger _roster_test_fail_charge on public.charges;
+drop function public._roster_test_fail_charge();
