+create or replace function public.move_household_member(
+  p_participant_id uuid,
+  p_destination_account_id uuid,
+  p_role text,
+  p_deactivate_source_account_id uuid default null
+)
+returns jsonb
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_dest_status text;
+  v_dest_name text;
+  v_membership text;
+  v_role text;
+  v_inserted uuid;
+  v_deactivated uuid;
+  v_note text;
+begin
+  if p_participant_id is null then
+    raise exception 'participant_id_required';
+  end if;
+  if p_destination_account_id is null then
+    raise exception 'destination_account_id_required';
+  end if;
+  if p_role is null or p_role not in ('member', 'payer', 'guardian') then
+    raise exception 'invalid_role';
+  end if;
+  if not exists (select 1 from public.participants p where p.id = p_participant_id) then
+    raise exception 'participant_id_required';
+  end if;
+
+  select a.status, a.primary_contact_name
+  into v_dest_status, v_dest_name
+  from public.accounts a
+  where a.id = p_destination_account_id
+  for update;
+  if v_dest_status is null or v_dest_status <> 'active' then
+    raise exception 'destination_account_not_active';
+  end if;
+
+  if p_deactivate_source_account_id is not null then
+    if p_deactivate_source_account_id = p_destination_account_id then
+      raise exception 'source_account_required_member';
+    end if;
+    perform 1 from public.accounts a where a.id = p_deactivate_source_account_id for update;
+    if not exists (
+      select 1
+      from public.account_members am
+      where am.account_id = p_deactivate_source_account_id
+        and am.participant_id = p_participant_id
+    ) then
+      raise exception 'source_account_required_member';
+    end if;
+  end if;
+
+  insert into public.account_members (account_id, participant_id, role)
+  values (p_destination_account_id, p_participant_id, p_role)
+  on conflict (account_id, participant_id) do nothing
+  returning id into v_inserted;
+
+  if v_inserted is null then
+    v_membership := 'already_present';
+    select am.role into v_role
+    from public.account_members am
+    where am.account_id = p_destination_account_id
+      and am.participant_id = p_participant_id;
+  else
+    v_membership := 'created';
+    v_role := p_role;
+  end if;
+
+  if p_deactivate_source_account_id is not null then
+    if not public.account_is_financially_empty(p_deactivate_source_account_id) then
+      raise exception 'source_account_has_financial_history';
+    end if;
+
+    delete from public.account_members
+    where account_id = p_deactivate_source_account_id
+      and participant_id = p_participant_id;
+
+    v_note := format(
+      'Household move: deactivated after adding participant %s to account %s (%s).',
+      p_participant_id,
+      p_destination_account_id,
+      coalesce(nullif(btrim(v_dest_name), ''), 'no contact name')
+    );
+
+    update public.accounts
+    set
+      status = 'inactive',
+      notes = concat_ws(E'\n', nullif(btrim(coalesce(notes, '')), ''), v_note)
+    where id = p_deactivate_source_account_id;
+
+    v_deactivated := p_deactivate_source_account_id;
+  end if;
+
+  return jsonb_build_object(
+    'participant_id', p_participant_id,
+    'destination_account_id', p_destination_account_id,
+    'role', v_role,
+    'membership', v_membership,
+    'deactivated_account_id', v_deactivated
+  );
+end;
+$$;
+
+comment on function public.move_household_member(uuid, uuid, text, uuid) is
+  'Adds account_members on the active destination. Deactivates the source only when it has no financial rows. Does not move charges, payments, or subscriptions.';
+
+revoke all on function public.move_household_member(uuid, uuid, text, uuid) from public;
+revoke all on function public.move_household_member(uuid, uuid, text, uuid) from anon;
+revoke all on function public.move_household_member(uuid, uuid, text, uuid) from authenticated;
+grant execute on function public.move_household_member(uuid, uuid, text, uuid) to service_role;
