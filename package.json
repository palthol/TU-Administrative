{
  "name": "temple-underground-admin",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:receipts dev:waiver-viewer dev:dashboard",
    "dev:receipts": "npm --workspace apps/receipts run dev",
    "dev:waiver-viewer": "npm --workspace apps/waiver-viewer run dev",
    "dev:dashboard": "npm --workspace apps/dashboard run dev",
    "build": "npm-run-all build:receipts build:waiver-viewer build:dashboard",
    "build:receipts": "npm --workspace apps/receipts run build",
    "build:waiver-viewer": "npm --workspace apps/waiver-viewer run build",
    "build:dashboard": "npm --workspace apps/dashboard run build",
    "test": "npm-run-all test:receipts",
    "test:receipts": "npm --workspace apps/receipts run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
